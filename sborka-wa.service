[Unit]
Description=СБОРКА — WhatsApp (Baileys): уведомления клиентам с номера
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/gektar_bot/sborka-app
ExecStart=/usr/bin/node /root/gektar_bot/sborka-app/src/wa_service.js
EnvironmentFile=/root/gektar_bot/sborka-app/.env
Restart=always
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
